# AI Provider
AI_RECOMMENDATIONS_ENABLED=true
AI_PROVIDER=gemini
# Get your API key from https://aistudio.google.com/app/apikey
AI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-3.5-flash-lite
AI_API_URL=
AI_MAX_RECOMMENDATIONS=8
AI_TIMEOUT=30

# Database (PostgreSQL required)
DATABASE_URL=postgresql://user:password@localhost:5432/health_ai

# JWT / Auth
JWT_SECRET=change-me-to-a-random-64-char-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Deployment environment: "production" enforces a strong ADMIN_PASSWORD.
# Leave unset for local development (a dev-only default is used).
APP_ENV=development

# Admin login password. REQUIRED in production (min 12 chars, no known defaults).
# Leave empty locally to use the development default.
ADMIN_PASSWORD=
